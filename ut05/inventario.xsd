<?xml version="1.0" encoding="UTF-8"?>
<!-- inventario.xsd - Esquema del inventario de red del aula (Práctica 05, Fase 5) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- tipoId: "EQ-" seguido de dos dígitos -->
  <xs:simpleType name="tipoId">
    <xs:restriction base="xs:string">
      <xs:pattern value="EQ-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- tipoIP: dirección IPv4, cuatro números de 0 a 255 separados por puntos -->
  <xs:simpleType name="tipoIP">
    <xs:restriction base="xs:string">
      <xs:pattern value="((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- tipoMAC: seis parejas hexadecimales en mayúsculas separadas por ":" -->
  <xs:simpleType name="tipoMAC">
    <xs:restriction base="xs:string">
      <xs:pattern value="([0-9A-F]{2}:){5}[0-9A-F]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- tipoEquipo: solo los tipos de equipo admitidos -->
  <xs:simpleType name="tipoEquipo">
    <xs:restriction base="xs:string">
      <xs:enumeration value="router"/>
      <xs:enumeration value="switch"/>
      <xs:enumeration value="punto_acceso"/>
      <xs:enumeration value="servidor"/>
      <xs:enumeration value="impresora"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- modelo: texto con el atributo obligatorio marca -->
  <xs:complexType name="tipoModelo">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="marca" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:element name="inventario">
    <xs:complexType>
      <xs:sequence>
        <!-- al menos cinco equipos -->
        <xs:element name="equipo" minOccurs="5" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nombre"       type="xs:string"/>
              <xs:element name="modelo"       type="tipoModelo"/>
              <xs:element name="ip"           type="tipoIP"/>
              <xs:element name="mac"          type="tipoMAC"/>
              <xs:element name="ubicacion"    type="xs:string"/>
              <xs:element name="fecha_compra" type="xs:date"/>
              <!-- número de puertos: opcional, solo para switches -->
              <xs:element name="puertos" type="xs:positiveInteger" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="id"   type="tipoId"     use="required"/>
            <xs:attribute name="tipo" type="tipoEquipo" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="aula"        type="xs:string" use="required"/>
      <xs:attribute name="actualizado" type="xs:date"   use="required"/>
    </xs:complexType>

    <!-- no se pueden repetir ni el id, ni la IP, ni la MAC -->
    <xs:unique name="idUnico">
      <xs:selector xpath="equipo"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="ipUnica">
      <xs:selector xpath="equipo"/>
      <xs:field xpath="ip"/>
    </xs:unique>
    <xs:unique name="macUnica">
      <xs:selector xpath="equipo"/>
      <xs:field xpath="mac"/>
    </xs:unique>
  </xs:element>

</xs:schema>
